# =====================================================================
# Salon Automatów (deckbuilder-ai-arena)
# Python server (gRPC, AI, RL, LLM) + Godot 4 C# client
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / PyInstaller (F07)
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Tests and tools
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/
.ipynb_checkpoints/

# Generated gRPC code for Python (generate from /proto instead of committing)
# Remove these lines if the team decides to commit generated code.
*_pb2.py
*_pb2.pyi
*_pb2_grpc.py

# ---------------------------------------------------------------------
# Godot 4
# ---------------------------------------------------------------------
# Godot cache and imported resources (regenerated on project open)
.godot/
# NOTE: *.import files next to assets MUST be committed in Godot 4

# Exports / builds of the client
client/builds/
client/export/
*.pck
*.exe
*.dmg

# Export presets can contain local paths and signing passwords
export_credentials.cfg

# ---------------------------------------------------------------------
